@base = http://localhost:8080
# @base = https://reservapp-api-v7dk.onrender.com
@reservaId = 1

# Ejecutar primero los tres logins: los demás pedidos toman el token de sus respuestas
@tokenEmpleado = {{loginEmpleado.response.body.token}}
@tokenTercerizado = {{loginTercerizado.response.body.token}}
@tokenAdmin = {{loginAdmin.response.body.token}}

### login empleado -> 200
# @name loginEmpleado
POST {{base}}/api/v1/auth/login
Content-Type: application/json

{ "correo": "empleado@reservapp.demo", "password": "password" }

### login tercerizado -> 200
# @name loginTercerizado
POST {{base}}/api/v1/auth/login
Content-Type: application/json

{ "correo": "tercerizado@reservapp.demo", "password": "password" }

### login admin -> 200
# @name loginAdmin
POST {{base}}/api/v1/auth/login
Content-Type: application/json

{ "correo": "admin@reservapp.demo", "password": "password" }

### login: contraseña incorrecta -> 401
POST {{base}}/api/v1/auth/login
Content-Type: application/json

{ "correo": "empleado@reservapp.demo", "password": "incorrecta" }

### health: exitoso -> 200
GET {{base}}/api/v1/health

### crear reserva: exitoso -> 201
POST {{base}}/api/v1/reservas
Authorization: Bearer {{tokenEmpleado}}
Content-Type: application/json

{
  "menuId": 1,
  "fecha": "2026-09-02",
  "comidaIds": [1, 3, 4, 5]
}

### crear reserva: body inválido -> 400
POST {{base}}/api/v1/reservas
Authorization: Bearer {{tokenEmpleado}}
Content-Type: application/json

{
  "menuId": null,
  "fecha": "2020-01-01",
  "comidaIds": []
}

### crear reserva: recurso relacionado inexistente -> 404
POST {{base}}/api/v1/reservas
Authorization: Bearer {{tokenEmpleado}}
Content-Type: application/json

{
  "menuId": 999999,
  "fecha": "2026-09-02",
  "comidaIds": [1, 3]
}

### listar reservas propias -> 200
GET {{base}}/api/v1/reservas?page=0&size=20
Authorization: Bearer {{tokenEmpleado}}

### obtener reserva -> 200
GET {{base}}/api/v1/reservas/{{reservaId}}
Authorization: Bearer {{tokenEmpleado}}

### obtener reserva inexistente -> 404
GET {{base}}/api/v1/reservas/999999
Authorization: Bearer {{tokenEmpleado}}

### modificar reserva: exitoso -> 200
PATCH {{base}}/api/v1/reservas/{{reservaId}}
Authorization: Bearer {{tokenEmpleado}}
Content-Type: application/json

{ "comidaIds": [1, 3, 4, 5] }

### modificar reserva: body inválido -> 400
PATCH {{base}}/api/v1/reservas/{{reservaId}}
Authorization: Bearer {{tokenEmpleado}}
Content-Type: application/json

{ "comidaIds": [] }

### modificar reserva inexistente -> 404
PATCH {{base}}/api/v1/reservas/999999
Authorization: Bearer {{tokenEmpleado}}
Content-Type: application/json

{ "comidaIds": [1, 3] }

### cancelar reserva: exitoso -> 204
DELETE {{base}}/api/v1/reservas/{{reservaId}}
Authorization: Bearer {{tokenEmpleado}}

### cancelar reserva inexistente -> 404
DELETE {{base}}/api/v1/reservas/999999
Authorization: Bearer {{tokenEmpleado}}

### confirmar asistencia: exitoso -> 201
POST {{base}}/api/v1/reservas/{{reservaId}}/confirmacion-asistencia
Authorization: Bearer {{tokenAdmin}}

### confirmar asistencia repetida -> 409
POST {{base}}/api/v1/reservas/{{reservaId}}/confirmacion-asistencia
Authorization: Bearer {{tokenAdmin}}

### confirmar asistencia de reserva inexistente -> 404
POST {{base}}/api/v1/reservas/999999/confirmacion-asistencia
Authorization: Bearer {{tokenAdmin}}

### listar reservas sin token -> 401
GET {{base}}/api/v1/reservas

### listar reservas con rol administrador -> 403
GET {{base}}/api/v1/reservas
Authorization: Bearer {{tokenAdmin}}

### obtener reserva ajena -> 404 (la reserva 1 es del empleado)
GET {{base}}/api/v1/reservas/{{reservaId}}
Authorization: Bearer {{tokenTercerizado}}

### confirmar asistencia con rol empleado -> 403
POST {{base}}/api/v1/reservas/{{reservaId}}/confirmacion-asistencia
Authorization: Bearer {{tokenEmpleado}}
